{
  "jeu": {
    "id": "variantes",
    "version": 3,
    "date_effet": "2026-10-04T10:00:00+02:00",
    "auteur": "juriste@cabinet.fr"
  },
  "directives": [
    {
      "id": "V-001",
      "version": 2,
      "statut": "brouillon",
      "date_effet": "2026-10-04T10:00:00+02:00",
      "revision_avant": "2026-12-31T23:00:00+01:00",
      "texte_fr": "Tout virement de plus de 10 000 euros vers l'étranger attend une validation.",
      "fondement": { "texte": "Code monétaire et financier", "article": "L561-10" },
      "verrou": "seuil_argument",
      "perimetre": { "appelants": ["spiffe://lab/agent-credit"] },
      "cible": { "serveur": "banque-synthetique", "outil": "virer" },
      "condition": [
        { "champ": "/montant", "op": ">", "valeur": 10000 },
        { "champ": "/pays", "op": "!=", "valeur": "FR" }
      ],
      "effet": "attendre_validation"
    },
    {
      "id": "V-002",
      "version": 1,
      "statut": "observation",
      "date_effet": "2026-10-04T08:00:00Z",
      "texte_fr": "Aucun outil de suppression.",
      "fondement": { "texte": "Politique interne" },
      "verrou": "interdiction",
      "cible": { "serveur": "*", "outil": "supprimer" },
      "effet": "refuser"
    },
    {
      "id": "V-003",
      "version": 1,
      "statut": "retiree",
      "date_effet": "2026-10-04T08:00:00Z",
      "texte_fr": "Le partenaire ne reçoit que le SIREN et l'adresse.",
      "fondement": { "texte": "RGPD", "article": "art. 5.1.c" },
      "verrou": "champs_autorises_par_destination",
      "cible": { "serveur": "recherche-entreprises", "outil": "*" },
      "champs": { "autorises": ["/siren", "/adresse"], "mode": "refuser" },
      "effet": "refuser"
    }
  ]
}
