{
  "jeu": {"id": "complet-v2", "version": 1, "date_effet": "2026-09-01T00:00:00Z", "auteur": "juriste@cabinet.fr"},
  "directives": [
    {
      "id": "X-001", "version": 1, "statut": "active", "date_effet": "2026-09-01T00:00:00Z",
      "revision_avant": "2027-09-01T00:00:00Z",
      "texte_fr": "Directive d'exemple qui emploie chaque feuille et chaque effet.",
      "fondements": [{"texte": "Exemple", "article": "1", "url": "https://example.org"}],
      "perimetre": {"appelants": ["spiffe://lab/agents/credit", "*"]},
      "si_indetermine": "ignorer",
      "si_indetermine_valide_par": "juriste@cabinet.fr",
      "declencheur": {"evenement": "appel_outil", "cible": {"serveur": "banque-synthetique", "outil": "*", "etiquette": "sensible", "acces": "action"}},
      "condition": {"ou": [
        {"et": [
          {"argument": {"champ": "/montant", "op": ">=", "valeur": 1.5e3}},
          {"argument": {"champ": "/devise", "op": "dans", "valeur": ["EUR", "USD"]}},
          {"argument": {"champ": "/code", "op": "prefixe", "valeur": "FR"}},
          {"argument": {"champ": "/note", "op": "absent"}}
        ]},
        {"session.a_consulte": {"outil": "taux-officiel/get_taux", "critere": "transmis"}},
        {"appelant": {"prefixe": "spiffe://lab/agents/"}},
        {"sous_agent_declare": {"dans": ["analyste", "redacteur"]}},
        {"demandeur": {"identite": {"egal": "alice@cabinet.fr"}}},
        {"attestation": {"verifiee": true, "mode": "spiffe"}},
        {"temps": {"heure": {"de": "20:00", "a": "07:00"}, "date": {"op": ">=", "valeur": "2026-12-24"}, "fuseau": "Europe/Paris"}},
        {"etiquette_cible": {"contient": "donnees_client"}},
        {"metadonnee_reponse": {"serveur": "taux-officiel", "champ": "source.origine", "op": "==", "valeur": "direct"}},
        {"metadonnee_reponse": {"etiquette": "officiel", "champ": "source.date", "op": ">=", "valeur": "2026-01-01T00:00:00Z"}},
        {"sujet": {"groupe": "vip", "champ": "/client_id"}},
        {"tous": {"champ": "/lignes", "condition": {"existe": {"champ": "/beneficiaires", "condition": {"non": {"sujet": {"groupe": "gel"}}}}}}}
      ]},
      "effets": [
        {"effet": "attendre_validation", "par_role": "directeur-risques", "quatre_yeux": true},
        {"effet": "caviarder", "champs_autorises": ["/montant", "/devise"], "mode": "caviarder"},
        {"effet": "notifier", "destinataire_role": "juridique", "rythme": "synthese", "si_echec": "continuer"},
        {"effet": "marquer", "etiquette": "revue-annuelle"}
      ]
    },
    {
      "id": "X-002", "version": 1, "statut": "brouillon", "date_effet": "2026-09-01T00:00:00Z",
      "texte_fr": "Évènement réservé : admis en brouillon.",
      "fondements": [{"texte": "Exemple"}],
      "declencheur": {"evenement": "ouverture_session"},
      "effets": [{"effet": "notifier", "destinataire_role": "rssi", "rythme": "synthese", "si_echec": "continuer"}]
    },
    {
      "id": "X-003", "version": 1, "statut": "active", "date_effet": "2026-09-01T00:00:00Z",
      "texte_fr": "Aucun appel à l'outil supprimer_tout, quel que soit le serveur.",
      "fondements": [{"texte": "Exemple"}],
      "declencheur": {"evenement": "appel_outil", "cible": {"serveur": "*", "outil": "supprimer_tout"}},
      "effets": [{"effet": "refuser"}]
    }
  ]
}
