      "fondement": {
        "texte": "RGPD — à valider par le juriste",
        "article": "5",
        "url": "https://eur-lex.europa.eu/eli/reg/2016/679/oj"
      },
      "verrou": "champs_autorises_par_destination",
      "cible": {
        "serveur": "recherche-entreprises",
